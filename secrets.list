# secrets.list — paths that are NEVER visible inside the sandbox, whatever
# tools.conf says. Installed root-owned (644) next to lib.sh:
#   root install: /usr/local/lib/ai-sandbox/secrets.list   (edit with sudo)
#   user install: ~/.local/lib/ai-sandbox/secrets.list     (NOT protected:
#                 anything running as you can change it)
# Your own additions/exceptions go in a secrets.conf, not here: this file is
# replaced on reinstall. Both are created empty for you:
#   /etc/ai-sandbox/secrets.conf       admin, root install (deny | allow)
#   ~/.config/ai-sandbox/secrets.conf  you (root install: deny only;
#                                      user install: deny | allow)
#
# One entry per line:  deny PATH     (~ = the home of whoever runs the tool)
# A path is refused if it is, contains, or sits inside an entry. Symlinks are
# resolved first, so a symlink to ~/.ssh doesn't help.
#
# FAIL CLOSED: if this file is missing, empty, not owned by root (root
# install), writable by group/others, sits in a folder that is, or has a
# line it doesn't understand, NO tool starts.
#
# This is a list of KNOWN token/key locations, not a complete one: a tool
# that keeps its token somewhere else is not covered.

# keys, password stores, git/http credentials
deny ~/.ssh
deny ~/.gnupg
deny ~/.password-store
deny ~/.pki
deny ~/.netrc
deny ~/.git-credentials
deny ~/.local/share/keyrings
deny ~/.config/op
deny ~/.config/Bitwarden
deny ~/.config/Bitwarden CLI

# cloud + infrastructure
deny ~/.aws
deny ~/.azure
deny ~/.config/gcloud
deny ~/.oci
deny ~/.kube
deny ~/.docker
deny ~/.config/doctl
deny ~/.config/hcloud
deny ~/.terraform.d
deny ~/.vault-token
deny ~/.config/rclone

# developer tokens
deny ~/.config/gh
deny ~/.config/hub
deny ~/.config/glab-cli
deny ~/.config/github-copilot
deny ~/.npmrc
deny ~/.yarnrc.yml
deny ~/.pypirc
deny ~/.cargo/credentials
deny ~/.cargo/credentials.toml
deny ~/.gem/credentials
# (~/.config/Code is not here: it is an editor's data dir, guarded by the
# per-tool isolation check like ~/.claude or ~/.config/Cursor)

# browsers + mail (Firefox family, Chromium family)
deny ~/.mozilla
deny ~/.thunderbird
deny ~/.config/google-chrome
deny ~/.config/chromium
deny ~/.config/BraveSoftware
deny ~/.config/microsoft-edge
deny ~/.config/vivaldi
deny ~/.config/opera

# ALL snap and Flatpak app data (their browsers keep profiles there)
deny ~/snap
deny ~/.var/app
